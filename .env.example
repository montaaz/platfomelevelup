DATABASE_URL="postgresql://postgres:postgres@localhost:5432/levelup"
AUTH_SECRET="generate-a-long-random-secret"
NEXT_PUBLIC_APP_NAME="Level Up IA"
APP_URL="http://localhost:3000"
# E-mail (facultatif en dev — sans clé, les e-mails sont seulement journalisés)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Level Up IA <notifications@levelupia.tn>"

# Connexion Google (console.cloud.google.com → API et services → Identifiants)
# Origine JavaScript autorisée : https://levelupia.app
# URI de redirection autorisée  : https://levelupia.app/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facultatif : force l'URL de retour envoyée à Google (doit être EXACTEMENT
# une "URI de redirection autorisée" de la console Google).
# Utile en local si seule l'URL de production est enregistrée.
# GOOGLE_REDIRECT_BASE="https://levelupia.app"
