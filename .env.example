DATABASE_URL="postgresql://postgres:postgres@localhost:5432/levelup"
AUTH_SECRET="generate-a-long-random-secret"
NEXT_PUBLIC_APP_NAME="Level Up IA"
APP_URL="http://localhost:3000"
# E-mail (facultatif en dev — sans clé, les e-mails sont seulement journalisés)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Level Up IA <notifications@levelupia.tn>"

# Connexion Google (console.cloud.google.com → API et services → Identifiants)
# Origine JavaScript autorisée : https://levelupia.app
# URI de redirection autorisée  : https://levelupia.app/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facultatif : force l'URL de retour envoyée à Google (doit être EXACTEMENT
# une "URI de redirection autorisée" de la console Google).
# Utile en local si seule l'URL de production est enregistrée.
# GOOGLE_REDIRECT_BASE="https://levelupia.app"

# Intégration site vitrine (levelupia.agency → levelupia.app)
# Le MÊME secret doit être configuré des deux côtés si le vitrine signe lui-même.
CART_TOKEN_SECRET=""
VITRINE_ORIGINS="https://levelupia.agency"

# Assistant IA local (Ollama sur CE serveur — aucune donnée ne sort de la machine)
# Sans BUDDY_AI=on, l'assistant reste purement à règles.
# BUDDY_AI=on
# OLLAMA_URL="http://127.0.0.1:11434"   # doit être une adresse locale, sinon l'IA est désactivée
# BUDDY_AI_MODEL="qwen2.5:3b"
# BUDDY_EMBED_MODEL="bge-m3"            # "off" pour s'en passer (recherche par mots seulement)
# BUDDY_AI_DEBUG=1                      # journalise extraits et réponses brutes — réglage uniquement

# Paiement en ligne ClicToPay (Attijari E-Payment). Sans identifiants, le
# bouton « Payer par carte » n'est pas affiché.
# Test : https://test.clictopay.com/payment/rest
# Production : https://ipay.clictopay.com/payment/rest
# CLICTOPAY_BASE_URL="https://test.clictopay.com/payment/rest"
# CLICTOPAY_USERNAME=""
# CLICTOPAY_PASSWORD=""
# Destinataire de l'e-mail « paiement accepté »
# PAYMENT_NOTIFY_EMAIL="contact@levelupia.agency"

# Envoi des e-mails par la boîte professionnelle (Google Workspace).
# SMTP_PASS est un « mot de passe d'application » Google, pas le mot de passe du compte.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="contact@levelupia.agency"
# SMTP_PASS=""
