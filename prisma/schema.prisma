// Level Up IA — Prisma schema, mapped 1:1 to database/schema.sql
// The SQL file is the source of truth; this mirror gives type-safe access.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// ---------------------------------------------------------------- enums

enum UserRole {
  ADMIN
  CLIENT

  @@map("user_role")
}

enum ProjectStatus {
  EN_ATTENTE
  EN_COURS
  EN_REVISION
  LIVRE
  CLOTURE

  @@map("project_status")
}

enum FileKind {
  LIVRABLE
  ELEMENT_CLIENT

  @@map("file_kind")
}

enum FileApproval {
  EN_ATTENTE
  APPROUVE
  REVISION_DEMANDEE

  @@map("file_approval")
}

enum InvoiceStatus {
  BROUILLON
  EN_ATTENTE
  PAYEE
  EN_RETARD
  ANNULEE

  @@map("invoice_status")
}

enum PaymentMethod {
  VIREMENT
  CARTE
  ESPECES
  CHEQUE
  EN_LIGNE

  @@map("payment_method")
}

enum SubscriptionStatus {
  ACTIF
  EN_PAUSE
  ANNULE
  EXPIRE

  @@map("subscription_status")
}

enum RequestStatus {
  NOUVELLE
  EN_ETUDE
  ACCEPTEE
  REFUSEE

  @@map("request_status")
}

enum NotificationType {
  STATUT_PROJET
  NOUVEAU_LIVRABLE
  NOUVELLE_FACTURE
  NOUVEAU_MESSAGE
  ABONNEMENT_ECHEANCE
  DEMANDE_PROJET

  @@map("notification_type")
}

// ---------------------------------------------------------------- models

model Client {
  id             BigInt    @id @default(autoincrement())
  companyName    String    @map("company_name") @db.VarChar(160)
  contactName    String    @map("contact_name") @db.VarChar(160)
  email          String?   @db.Citext
  phone          String?   @db.VarChar(40)
  address        String?
  city           String?   @db.VarChar(80)
  country        String?   @default("Tunisie") @db.VarChar(80)
  taxId          String?   @map("tax_id") @db.VarChar(60)
  billingAddress String?   @map("billing_address")
  notes          String?
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  users           User[]
  projects        Project[]
  invoices        Invoice[]
  subscriptions   Subscription[]
  projectRequests ProjectRequest[]

  @@map("clients")
}

model User {
  id                  BigInt    @id @default(autoincrement())
  role                UserRole
  clientId            BigInt?   @map("client_id")
  fullName            String    @map("full_name") @db.VarChar(160)
  email               String    @unique @db.Citext
  passwordHash        String    @map("password_hash")
  isActive            Boolean   @default(true) @map("is_active")
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts") @db.SmallInt
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  client              Client?                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  teamMember          TeamMember?
  resetTokens         PasswordResetToken[]
  messages            Message[]
  messageReads        MessageRead[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  uploadedFiles       File[]
  createdProjects     Project[]              @relation("ProjectCreatedBy")
  statusChanges       ProjectStatusHistory[]
  createdInvoices     Invoice[]
  createdRequests     ProjectRequest[]
  addedIpExceptions   IpException[]

  @@map("users")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model TeamMember {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?  @unique @map("user_id")
  fullName  String   @map("full_name") @db.VarChar(160)
  email     String?  @db.Citext
  phone     String?  @db.VarChar(40)
  jobTitle  String?  @map("job_title") @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedProjects Project[]

  @@map("team_members")
}

model Service {
  id           BigInt   @id @default(autoincrement())
  name         String   @unique @db.VarChar(120)
  description  String?
  defaultPrice Decimal? @map("default_price") @db.Decimal(12, 3)
  color        String?  @db.VarChar(9)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  projects        Project[]
  projectRequests ProjectRequest[]

  @@map("services")
}

model Project {
  id                   BigInt        @id @default(autoincrement())
  clientId             BigInt        @map("client_id")
  serviceId            BigInt        @map("service_id")
  assignedTeamMemberId BigInt?       @map("assigned_team_member_id")
  createdByUserId      BigInt?       @map("created_by_user_id")
  title                String        @db.VarChar(200)
  description          String?
  price                Decimal       @default(0) @db.Decimal(12, 3)
  currency             String        @default("TND") @db.Char(3)
  status               ProjectStatus @default(EN_ATTENTE)
  startDate            DateTime?     @map("start_date") @db.Date
  dueDate              DateTime?     @map("due_date") @db.Date
  deliveredAt          DateTime?     @map("delivered_at") @db.Timestamptz(6)
  closedAt             DateTime?     @map("closed_at") @db.Timestamptz(6)
  deletedAt            DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  client          Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  service         Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  assignedTo      TeamMember?            @relation(fields: [assignedTeamMemberId], references: [id], onDelete: SetNull)
  createdBy       User?                  @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  steps           ProjectStep[]
  statusHistory   ProjectStatusHistory[]
  files           File[]
  messages        Message[]
  invoices        Invoice[]
  createdFromReqs ProjectRequest[]

  @@map("projects")
}

model ProjectStep {
  id        BigInt    @id @default(autoincrement())
  projectId BigInt    @map("project_id")
  label     String    @db.VarChar(120)
  position  Int       @db.SmallInt
  reachedAt DateTime? @map("reached_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, position])
  @@map("project_steps")
}

model ProjectStatusHistory {
  id              BigInt         @id @default(autoincrement())
  projectId       BigInt         @map("project_id")
  oldStatus       ProjectStatus? @map("old_status")
  newStatus       ProjectStatus  @map("new_status")
  changedByUserId BigInt?        @map("changed_by_user_id")
  comment         String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@map("project_status_history")
}

model File {
  id               BigInt        @id @default(autoincrement())
  publicId         String        @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  projectId        BigInt        @map("project_id")
  uploadedByUserId BigInt?       @map("uploaded_by_user_id")
  kind             FileKind
  approval         FileApproval?
  originalName     String        @map("original_name") @db.VarChar(255)
  storageKey       String        @unique @map("storage_key")
  mimeType         String        @map("mime_type") @db.VarChar(120)
  sizeBytes        BigInt        @map("size_bytes")
  version          Int           @default(1) @db.SmallInt
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@map("files")
}

model Message {
  id           BigInt   @id @default(autoincrement())
  projectId    BigInt   @map("project_id")
  senderUserId BigInt   @map("sender_user_id")
  body         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender  User          @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  reads   MessageRead[]

  @@map("messages")
}

model MessageRead {
  messageId BigInt   @map("message_id")
  userId    BigInt   @map("user_id")
  readAt    DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("message_reads")
}

model InvoiceCounter {
  year       Int @id @db.SmallInt
  lastNumber Int @default(0) @map("last_number")

  @@map("invoice_counters")
}

model Invoice {
  id              BigInt        @id @default(autoincrement())
  invoiceNumber   String        @unique @map("invoice_number") @db.VarChar(20)
  clientId        BigInt        @map("client_id")
  projectId       BigInt?       @map("project_id")
  status          InvoiceStatus @default(BROUILLON)
  issueDate       DateTime      @default(dbgenerated("CURRENT_DATE")) @map("issue_date") @db.Date
  dueDate         DateTime?     @map("due_date") @db.Date
  subtotal        Decimal       @default(0) @db.Decimal(12, 3)
  vatRate         Decimal       @default(19.00) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount       Decimal       @default(0) @map("vat_amount") @db.Decimal(12, 3)
  total           Decimal       @default(0) @db.Decimal(12, 3)
  currency        String        @default("TND") @db.Char(3)
  notes           String?
  sentAt          DateTime?     @map("sent_at") @db.Timestamptz(6)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdByUserId BigInt?       @map("created_by_user_id")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  client    Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines     InvoiceLine[]
  payments  Payment[]

  @@map("invoices")
}

model InvoiceLine {
  id          BigInt  @id @default(autoincrement())
  invoiceId   BigInt  @map("invoice_id")
  description String  @db.VarChar(300)
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 3)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 3)
  position    Int     @default(1) @db.SmallInt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_lines")
}

model Payment {
  id        BigInt        @id @default(autoincrement())
  invoiceId BigInt        @map("invoice_id")
  amount    Decimal       @db.Decimal(12, 3)
  method    PaymentMethod
  reference String?       @db.VarChar(120)
  paidAt    DateTime      @default(now()) @map("paid_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@map("payments")
}

model Subscription {
  id            BigInt             @id @default(autoincrement())
  clientId      BigInt             @map("client_id")
  planName      String             @map("plan_name") @db.VarChar(80)
  monthlyAmount Decimal            @map("monthly_amount") @db.Decimal(12, 3)
  currency      String             @default("TND") @db.Char(3)
  status        SubscriptionStatus @default(ACTIF)
  autoRenew     Boolean            @default(true) @map("auto_renew")
  startDate     DateTime           @map("start_date") @db.Date
  renewalDate   DateTime           @map("renewal_date") @db.Date
  cancelledAt   DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

model ProjectRequest {
  id               BigInt        @id @default(autoincrement())
  clientId         BigInt        @map("client_id")
  createdByUserId  BigInt?       @map("created_by_user_id")
  serviceId        BigInt?       @map("service_id")
  title            String        @db.VarChar(200)
  description      String?
  status           RequestStatus @default(NOUVELLE)
  adminNote        String?       @map("admin_note")
  createdProjectId BigInt?       @map("created_project_id")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy      User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  service        Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdProject Project? @relation(fields: [createdProjectId], references: [id], onDelete: SetNull)

  @@map("project_requests")
}

model Notification {
  id         BigInt           @id @default(autoincrement())
  userId     BigInt           @map("user_id")
  type       NotificationType
  title      String           @db.VarChar(200)
  body       String?
  entityType String?          @map("entity_type") @db.VarChar(40)
  entityId   BigInt?          @map("entity_id")
  readAt     DateTime?        @map("read_at") @db.Timestamptz(6)
  emailedAt  DateTime?        @map("emailed_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt?  @map("user_id")
  action     String   @db.VarChar(80)
  entityType String?  @map("entity_type") @db.VarChar(40)
  entityId   BigInt?  @map("entity_id")
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model IpException {
  id        BigInt   @id @default(autoincrement())
  ipAddress String   @unique @map("ip_address") @db.Inet
  reason    String?  @db.VarChar(200)
  addedBy   BigInt?  @map("added_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  addedByUser User? @relation(fields: [addedBy], references: [id], onDelete: SetNull)

  @@map("ip_exceptions")
}

model AccessDenial {
  id        BigInt   @id @default(autoincrement())
  ipAddress String   @map("ip_address") @db.Inet
  reason    String?  @db.VarChar(120)
  path      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("access_denials")
}
